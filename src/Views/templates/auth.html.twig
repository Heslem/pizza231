{% extends 'base.html.twig' %}

{% block content %}
{% set mode = mode|default('login') %}

{% if mode == 'register' %}
    {% set formText = texts.register|default({}) %}
{% elseif mode == 'verify' %}
    {% set formText = texts.verify|default({}) %}
{% else %}
    {% set formText = texts.login|default({}) %}
{% endif %}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="text-center mb-4">{{ formText.title|default(mode == 'register' ? 'Регистрация' : (mode == 'verify' ? 'Подтверждение email' : 'Вход')) }}</h2>

                    {% if success is defined and success is not empty %}
                        <div class="alert alert-success">{{ success }}</div>
                    {% endif %}

                    {% if error is defined and error is not empty %}
                        <div class="alert alert-danger">{{ error }}</div>
                    {% endif %}

                    {% if mode == 'register' %}
                        <form method="POST" action="/register">
                            <div class="mb-3">
                                <label for="name" class="form-label">{{ formText.name|default('Имя') }}</label>
                                <input type="text" class="form-control" id="name" name="name" required>
                            </div>
                            <div class="mb-3">
                                <label for="email" class="form-label">{{ formText.email|default('Email') }}</label>
                                <input type="email" class="form-control" id="email" name="email" required>
                            </div>
                            <div class="mb-3">
                                <label for="password" class="form-label">{{ formText.password|default('Пароль') }}</label>
                                <input type="password" class="form-control" id="password" name="password" required minlength="6">
                                <div class="form-text">{{ formText.passwordHint|default('Минимум 6 символов') }}</div>
                            </div>
                            <div class="mb-3">
                                <label for="password_confirm" class="form-label">{{ formText.passwordConfirm|default('Подтверждение пароля') }}</label>
                                <input type="password" class="form-control" id="password_confirm" name="password_confirm" required>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">{{ formText.submit|default('Зарегистрироваться') }}</button>
                        </form>

                        <div class="text-center mt-3">
                            <span class="text-muted">{{ formText.hasAccount|default('Уже есть аккаунт?') }}</span>
                            <a href="/login">{{ formText.loginLink|default('Войти') }}</a>
                        </div>
                    {% elseif mode == 'verify' %}
                        <div class="text-center mb-4">
                            <p class="text-muted">{{ formText.subtitle|default('На ваш email отправлен код подтверждения') }}</p>
                            <strong>{{ email|default('') }}</strong>
                        </div>

                        <form method="POST" action="/verify" id="verifyForm">
                            <div class="mb-3">
                                <label for="code" class="form-label">{{ formText.codeLabel|default('Код подтверждения') }}</label>
                                <input type="text" class="form-control text-center" id="code" name="code"
                                       required maxlength="6" pattern="[0-9]{6}"
                                       placeholder="000000" style="font-size: 24px; letter-spacing: 8px;">
                            </div>
                            <button type="submit" class="btn btn-primary w-100">{{ formText.submitVerify|default('Подтвердить') }}</button>
                        </form>

                        <div class="text-center mt-3">
                            <button type="button" class="btn btn-link" id="resendBtn">
                                {{ formText.resend|default('Отправить код повторно') }}
                            </button>
                            <div id="resendMessage" class="mt-2" style="display: none;"></div>
                        </div>

                        <div class="text-center mt-3">
                            <span class="text-muted">{{ formText.wrongEmail|default('Неверный email?') }}</span>
                            <a href="/register">{{ formText.registerAgain|default('Зарегистрироваться заново') }}</a>
                        </div>
                    {% else %}
                        <form method="POST" action="/login">
                            <div class="mb-3">
                                <label for="email" class="form-label">{{ formText.email|default('Email') }}</label>
                                <input type="email" class="form-control" id="email" name="email" required>
                            </div>
                            <div class="mb-3">
                                <label for="password" class="form-label">{{ formText.password|default('Пароль') }}</label>
                                <input type="password" class="form-control" id="password" name="password" required>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">{{ formText.submit|default('Войти') }}</button>
                        </form>

                        <div class="text-center mt-3">
                            <span class="text-muted">{{ formText.noAccount|default('Нет аккаунта?') }}</span>
                            <a href="/register">{{ formText.registerLink|default('Регистрация') }}</a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{% if mode == 'verify' %}
<script>
document.getElementById('verifyForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const code = document.getElementById('code').value;

    fetch('/api/auth/verify', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({code: code})
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            window.location.href = '/';
        } else {
            alert(data.error || 'Ошибка подтверждения');
        }
    })
    .catch(() => alert('Ошибка соединения'));
});

document.getElementById('resendBtn').addEventListener('click', function() {
    const btn = this;
    btn.disabled = true;

    fetch('/api/auth/resend', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'}
    })
    .then(r => r.json())
    .then(data => {
        const msg = document.getElementById('resendMessage');
        msg.style.display = 'block';
        if (data.success) {
            msg.className = 'mt-2 text-success';
            msg.textContent = data.message;
        } else {
            msg.className = 'mt-2 text-danger';
            msg.textContent = data.error;
        }
        btn.disabled = false;
    })
    .catch(() => {
        alert('Ошибка соединения');
        btn.disabled = false;
    });
});
</script>
{% endif %}
{% endblock %}
