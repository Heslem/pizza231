{% extends 'base.html.twig' %}

{% block content %}
{% set usersText = texts.users|default({}) %}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">{{ usersText.title|default('Пользователи') }}</h1>
        <a href="/admin" class="btn btn-outline-secondary">{{ usersText.back|default('Назад в панель') }}</a>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>{{ usersText.id|default('ID') }}</th>
                            <th>{{ usersText.name|default('Имя') }}</th>
                            <th>{{ usersText.email|default('Email') }}</th>
                            <th>{{ usersText.registered|default('Дата регистрации') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if users is empty %}
                            <tr><td colspan="4" class="text-center py-4 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2"></i>{{ usersText.noUsers|default('Пользователей пока нет') }}
                            </td></tr>
                        {% else %}
                            {% for user in users %}
                                <tr>
                                    <td>{{ user.id|default('—') }}</td>
                                    <td>{{ user.name|default('—') }}</td>
                                    <td>{{ user.email|default('—') }}</td>
                                    <td>{{ user.created_at ? user.created_at|date('d.m.Y H:i') : '—' }}</td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
