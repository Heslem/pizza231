{% extends 'base.html.twig' %}

{% set history = texts.history|default({}) %}
{% set contacts = texts.contacts|default({}) %}
{% set mapId = 'YOUR_CONSTRUCTOR_ID' %}

{% block content %}
<div class="container mt-4">
    <h1 class="text-center mb-4">{{ texts.title|default('О кафе «Бе-Бе»') }}</h1>

    <div class="row">
        <div class="col-md-8">
            <p class="lead">
                {{ texts.intro|default('Добро пожаловать в кафе «Бе-Бе» — настоящий уголок Востока в Кемерово!') }}
            </p>

            <p>
                {{ history.founded|default('Кафе открылось в') }}
                <strong>{{ history.foundedYear|default('2018 году') }}</strong>
                {{ history.reason|default('чтобы порадовать жителей города настоящей уйгурско-узбецкой кухней.') }}
            </p>

            <p>
                {{ history.today|default('') }}
            </p>

            <p>
                {{ history.graduates|default('За годы работы мы поставили свыше') }}
                <strong>{{ history.graduatesCount|default('50 000 блюд') }}</strong>
                {{ history.forText|default('довольным гостям.') }}
            </p>

            <p>
                {{ history.teachers|default('Наши повара — мастера своего дела, которые используют только свежие ингредиенты и натуральные специи.') }}
            </p>

            <h4 class="mt-4">{{ contacts.title|default('Контакты') }}</h4>
            <ul class="list-unstyled">
                <li><i class="bi bi-geo-alt-fill me-2" style="color: var(--cafe-orange);"></i>{{ contacts.address|default('Адрес:') }} {{ contacts.addressValue|default('г. Кемерово, ул. Примерная, д. 1') }}</li>
                <li><i class="bi bi-telephone-fill me-2" style="color: var(--cafe-orange);"></i>{{ contacts.phone|default('Телефон:') }} {{ contacts.phoneValue|default('+7 (3842) 12-34-56') }}</li>
                <li><i class="bi bi-envelope-fill me-2" style="color: var(--cafe-orange);"></i>{{ contacts.email|default('E-mail:') }} {{ contacts.emailValue|default('info@cafe-be-be.ru') }}</li>
                <li><i class="bi bi-person-fill me-2" style="color: var(--cafe-orange);"></i>{{ contacts.director|default('Шеф-повар:') }} {{ contacts.directorName|default('Ахмедов Бека') }}</li>
            </ul>
        </div>

        <div class="col-md-4">
            <!-- Карта Яндекс -->
            <div class="card">
                <div class="card-body p-0">
                    <script type="text/javascript" charset="utf-8"
                            async src="https://api-maps.yandex.ru/services/constructor/1.0/js/?um=constructor%3A{{ mapId }}&amp;width=100%25&amp;height=300&amp;lang=ru_RU&amp;scroll=true">
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
