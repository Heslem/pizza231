{% extends 'base.html.twig' %}

{% block content %}
{% set dashboardText = texts.dashboard|default({}) %}
{% set cardsText = texts.cards|default({}) %}
{% set revenueFormatted = stats.total_revenue|default(0)|number_format(0, '.', ' ') %}

<div class="container py-4">
    <h1 class="mb-4">{{ dashboardText.title|default('Панель администратора') }}</h1>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">{{ dashboardText.users|default('Пользователи') }}</h6>
                            <h2 class="mb-0">{{ stats.total_users|default(0) }}</h2>
                        </div>
                        <i class="bi bi-people fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">{{ dashboardText.products|default('Товары') }}</h6>
                            <h2 class="mb-0">{{ stats.total_products|default(0) }}</h2>
                        </div>
                        <i class="bi bi-box fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">{{ dashboardText.orders|default('Заказы') }}</h6>
                            <h2 class="mb-0">{{ stats.total_orders|default(0) }}</h2>
                        </div>
                        <i class="bi bi-cart fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">{{ dashboardText.revenue|default('Выручка') }}</h6>
                            <h2 class="mb-0">{{ revenueFormatted }} ₽</h2>
                        </div>
                        <i class="bi bi-currency-dollar fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-box-seam me-2"></i>{{ cardsText.catalogTitle|default('Управление каталогом') }}</h5>
                </div>
                <div class="card-body">
                    <p>{{ cardsText.catalogDesc|default('Добавление, редактирование и удаление товаров') }}</p>
                    <a href="/admin/catalog" class="btn btn-success">{{ cardsText.catalogLink|default('Перейти к каталогу') }}</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-cart me-2"></i>{{ cardsText.ordersTitle|default('Управление заказами') }}</h5>
                </div>
                <div class="card-body">
                    <p>{{ cardsText.ordersDesc|default('Просмотр и управление заказами клиентов') }}</p>
                    <a href="/admin/orders" class="btn btn-primary">{{ cardsText.ordersLink|default('Перейти к заказам') }}</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-people me-2"></i>{{ cardsText.usersTitle|default('Управление пользователями') }}</h5>
                </div>
                <div class="card-body">
                    <p>{{ cardsText.usersDesc|default('Просмотр списка зарегистрированных пользователей') }}</p>
                    <a href="/admin/users" class="btn btn-primary">{{ cardsText.usersLink|default('Перейти к пользователям') }}</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>{{ cardsText.logsTitle|default('Логи ошибок') }}</h5>
                </div>
                <div class="card-body">
                    <p>{{ cardsText.logsDesc|default('Просмотр и управление логами ошибок сайта') }}</p>
                    <a href="/admin/logs" class="btn btn-warning">{{ cardsText.logsLink|default('Перейти к логам') }}</a>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
